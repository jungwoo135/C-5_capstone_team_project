# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. .env.local 은 공유하지 마세요.

# RDS 콘솔의 Endpoint 주소
DB_HOST=shinjung.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=shinjung
DB_USERNAME=admin
DB_PASSWORD=비밀번호

# trust: 암호화하지만 서버 인증서는 검사하지 않습니다. (개발용)
# verify-full: 암호화하고 인증서도 검사합니다. (실제 서비스용, DB_SSL_CA_FILE 필요)
# disable: 암호화하지 않습니다. (내 컴퓨터의 DB에 접속할 때만)
DB_SSL_MODE=trust
# DB_SSL_CA_FILE=/경로/global-bundle.pem
