# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. .env.local 은 공유하지 마세요.

# RDS 콘솔의 Endpoint 주소
DB_HOST=shinjung.xxxxxxxx.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=shinjung
DB_USERNAME=admin
DB_PASSWORD=비밀번호

# trust: 암호화하지만 서버 인증서는 검사하지 않습니다. (개발용)
# verify-full: 암호화하고 인증서도 검사합니다. (실제 서비스용, DB_SSL_CA_FILE 필요)
# disable: 암호화하지 않습니다. (내 컴퓨터의 DB에 접속할 때만)
DB_SSL_MODE=trust
# DB_SSL_CA_FILE=/경로/global-bundle.pem

# 로그인 토큰 서명에 쓰는 비밀 문자열. 32자 이상의 아무 값으로 정하고 절대 공유하지 마세요.
# 서버에서 만들기: openssl rand -base64 32
SESSION_SECRET=여기에_32자_이상_임의_문자열

# HTTPS를 적용한 뒤 true로 바꾸면 로그인 쿠키가 HTTPS에서만 전송됩니다. (HTTP 단계에서는 끈 채로 두세요)
# COOKIE_SECURE=true

# 물품 인증을 처리하는 Python AI 서버 주소. 설정하지 않으면 물품 인증 API만 503으로 답하고 나머지는 정상 동작합니다.
# AI_SERVER_URL=http://127.0.0.1:8600/verify

# AI 서버 응답을 기다리는 최대 시간 (밀리초, 기본 8000)
# AI_SERVER_TIMEOUT_MS=8000
